{
  "manifest_version": 3,
  "name": "Modern Web Dino",
  "version": "1.0.0",
  "description": "Evaluate modernization opportunities for any website using Gemini and the Modern Web Guidance database.",
  "devtools_page": "devtools.html",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "audioCapture",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-isolated.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "dino-agent.png",
    "32": "dino-agent.png",
    "48": "dino-agent.png",
    "128": "dino-agent.png"
  },
  "action": {
    "default_icon": {
      "16": "dino-agent.png",
      "32": "dino-agent.png",
      "48": "dino-agent.png",
      "128": "dino-agent.png"
    }
  }
}
